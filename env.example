# Server Configuration
PORT=8080
WS_PATH=/ws

# Queue and Buffer Configuration
QUEUE_MAX=100
RING_BUFFER_SIZE=100
SLOW_CONSUMER_THRESHOLD=50

# Graceful Shutdown
GRACEFUL_TIMEOUT_MS=5000

# Authentication (optional)
API_KEY=

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Heartbeat
HEARTBEAT_INTERVAL=30000
